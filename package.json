{
  "name": "masterscards",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "version": "node scripts/stamp-changelog.ts && git add src/content/changelog.yaml",
    "tokens": "node scripts/gen-tokens.ts",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:visual": "playwright test",
    "cap:sync": "npm run build && cap sync",
    "icons": "node scripts/gen-icons.ts",
    "phone": "sh scripts/phone.sh",
    "dev:phone": "sh scripts/dev-phone.sh",
    "maquettes": "node scripts/render-maquettes.ts",
    "planche": "node scripts/decouper-planche.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.94.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
